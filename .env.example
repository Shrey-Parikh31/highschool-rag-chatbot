# Server-side only. No VITE_ prefix — a VITE_ var is compiled into the browser
# bundle and is therefore public. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest, which Google repoints as new
# Flash models ship. Set an exact id here only to pin a specific release.
GEMINI_MODEL=

# Shared staff passcode for teacher mode. If unset, teacher mode is unreachable
# and every request is served as a student.
TEACHER_PASSCODE=

# Used only when the primary is saturated (free tier 503s). Keep this a
# "-latest" alias too — pinned model ids get retired without warning.
GEMINI_FALLBACK_MODEL=

# NOTE: the Gemini free tier allows only 20 requests/day/model/project. Enable
# billing on the Google Cloud project behind the key for classroom-scale use.

# Set to 1 to enable /api/diag, a staff-gated credential diagnostic. Leave unset
# in production. Useful when retrieval works locally but not on the deployment.
ENABLE_DIAG=

# Per-IP requests allowed per 5 minutes on /api/chat. Defaults to 15.
RATE_LIMIT_PER_5MIN=

# Sign-in providers. These two ARE meant to be public, which is why they carry
# the VITE_ prefix: a client id identifies the app, it does not authorise it.
# Leave either blank and that button says it needs configuring instead of
# failing when someone clicks it.
#   Google:    https://console.cloud.google.com/apis/credentials
#              Create OAuth client ID > Web application, and list your site
#              under Authorised JavaScript origins.
#   Microsoft: https://portal.azure.com > App registrations > New registration,
#              platform Single-page application, and tick ID tokens.
VITE_GOOGLE_CLIENT_ID=
VITE_MS_CLIENT_ID=
